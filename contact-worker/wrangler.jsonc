{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carnet-dd-contact",
  "account_id": "160f96a41efd2629170558cb351d8972",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "blog.digitaldream.work/api/contact*", "zone_name": "digitaldream.work"},
    {"pattern": "blog.digitaldream.work/api/newsletter*", "zone_name": "digitaldream.work"},
    {"pattern": "blog.digitaldream.work/newsletter/confirm*", "zone_name": "digitaldream.work"},
    {"pattern": "blog.digitaldream.work/newsletter/unsubscribe*", "zone_name": "digitaldream.work"}
  ],
  "vars": {"SMTP_HOST":"eu1.workspace.org", "SMTP_USER":"blog@digitaldream.work"},
  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "carnet-dd-newsletter",
      "database_id": "dcbfcc2b-36bf-410c-aa69-961ba82c92bb",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {"name":"CONTACT_LIMIT", "namespace_id":"1001", "simple":{"limit":3,"period":60}},
    {"name":"GLOBAL_LIMIT", "namespace_id":"1002", "simple":{"limit":10,"period":60}},
    {"name":"NEWSLETTER_LIMIT", "namespace_id":"1003", "simple":{"limit":3,"period":60}}
  ],
  "observability": {"enabled":true}
}
