---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getCurrentLanguage } from '../../lib/i18n';

const currentLang = getCurrentLanguage();

const blog = (await getCollection('blog'))
  .filter((post: any) => !post.data.draft && post.data.lang === currentLang)
  .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());

const t = {
  fr: { label: 'BLOG — TOUS LES ARTICLES', title: 'Tous les articles', sub: 'Notes, expérimentations et réflexions.', read: 'Lire' },
  en: { label: 'BLOG — ALL ARTICLES', title: 'All articles', sub: 'Notes, experiments, and reflections.', read: 'Read' },
}[currentLang];

function fmtDate(d: Date | string, lang: string) {
  return new Date(d).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
    day: '2-digit', month: 'short', year: 'numeric',
  });
}
---

<Layout title={`${t.title} — DigitalDream`}>
  <main class="min-h-screen">
    <section class="px-6 md:px-12 pt-20 md:pt-32 pb-12 md:pb-20">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-[11px] tracking-[0.2em] text-neutral-500 dark:text-neutral-500 block mb-6">
          {t.label}
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-medium tracking-tight leading-[1.05] text-neutral-900 dark:text-neutral-50">
          <span class="font-serif italic font-normal">{t.title}</span>
        </h1>
        <p class="mt-6 text-base text-neutral-600 dark:text-neutral-400 max-w-md">{t.sub}</p>
      </div>
    </section>

    <section class="border-t border-neutral-300/70 dark:border-neutral-700/70">
      <ul class="max-w-7xl mx-auto divide-y divide-neutral-300/70 dark:divide-neutral-700/70">
        {blog.map((post: any, idx: number) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block px-6 md:px-12 py-8 md:py-10 hover:bg-stone-100/60 dark:hover:bg-neutral-800/40 transition-colors">
              <article class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-10 items-start">
                <div class="md:col-span-2 md:order-1 order-2 flex md:flex-col gap-4 md:gap-1 font-mono text-[11px] tracking-widest uppercase text-neutral-500 dark:text-neutral-500">
                  <span class="text-neutral-400 dark:text-neutral-600">{String(idx + 1).padStart(2, '0')}</span>
                  <span>{fmtDate(post.data.date, currentLang)}</span>
                </div>
                <div class={post.data.cover ? 'md:col-span-7 md:order-2 order-3' : 'md:col-span-10 md:order-2 order-3'}>
                  <h2 class="text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight leading-[1.1] text-neutral-900 dark:text-neutral-100">
                    <span class="link-hover">{post.data.title}</span>
                  </h2>
                  {post.data.description && (
                    <p class="mt-3 text-sm md:text-base text-neutral-600 dark:text-neutral-400 line-clamp-2 max-w-2xl">
                      {post.data.description}
                    </p>
                  )}
                </div>
                {post.data.cover && (
                  <div class="md:col-span-3 md:order-3 order-1">
                    <div class="aspect-[4/3] overflow-hidden bg-stone-200 dark:bg-neutral-800 rounded-sm">
                      <img src={post.data.cover} alt={post.data.title} loading="lazy" class="w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-[1.03]" />
                    </div>
                  </div>
                )}
              </article>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
