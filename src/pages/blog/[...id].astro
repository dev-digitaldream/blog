---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getCollection, render } from 'astro:content';
import { getCurrentLanguage } from '../../lib/i18n';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  return blog.map((post: any) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const currentLang = getCurrentLanguage();

const stats = readingTime(post.body || '');
const readMinutes = Math.max(1, Math.round(stats.minutes));

const allPosts = await getCollection('blog', ({ data }: any) => !data.draft);
const related = allPosts
  .filter((p: any) => p.id !== post.id && p.data.lang === post.data.lang)
  .map((p: any) => {
    const sharedTags = (p.data.tags ?? []).filter((t: string) => (post.data.tags ?? []).includes(t)).length;
    const sameCategory = p.data.category && p.data.category === post.data.category ? 2 : 0;
    return { post: p, score: sharedTags + sameCategory };
  })
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map((r) => r.post);

function fmtDateLong(d: Date | string, lang: string) {
  return new Date(d).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

const strings = {
  fr: {
    back: 'retour au carnet',
    minRead: 'min de lecture',
    stamp: 'testé pour de vrai',
    relatedHand: 'à lire ensuite',
    relatedTitle: 'D’autres pages du carnet',
    read: 'lire',
  },
  en: {
    back: 'back to the notebook',
    minRead: 'min read',
    stamp: 'tested for real',
    relatedHand: 'read next',
    relatedTitle: 'More notebook pages',
    read: 'read',
  },
};
const t = strings[post.data.lang as 'fr' | 'en'] ?? strings.fr;
const writtenOn = post.data.lang === 'en'
  ? `scribbled on ${fmtDateLong(post.data.date, 'en')}`
  : `gribouillé le ${fmtDateLong(post.data.date, 'fr')}`;

const tilts = ['tilt-1', 'tilt-2', 'tilt-3'];
---

<Layout
  title={`${post.data.title} · DigitalDream`}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
  translationSlug={post.data.translation}
>
  <ReadingProgress />

  <main class="min-h-screen text-ink relative">
    <!-- Marge rouge façon cahier -->
    <div class="hidden lg:block absolute top-0 bottom-0 left-10 w-px bg-pen/25 pointer-events-none" aria-hidden="true"></div>
    <div class="hidden lg:block absolute top-0 bottom-0 left-[42px] w-px bg-pen/25 pointer-events-none" aria-hidden="true"></div>

    <article
      class="relative max-w-3xl mx-auto px-6 md:px-12 pt-14 md:pt-20 pb-16 md:pb-24"
      data-pagefind-body
      data-pagefind-meta={`title:${post.data.title}`}
      data-pagefind-filter={`lang:${post.data.lang}`}
    >
      <!-- Retour + méta -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-10">
        <a href="/blog" class="link-hand hand text-xl md:text-2xl inline-flex items-center">
          <svg class="rotate-180 mr-1.5" width="20" height="10" viewBox="0 0 26 12" fill="none" aria-hidden="true">
            <path d="M1.5 6.5 C 8 4.5, 15 8, 22.5 6 M19.5 2.5 C 21 4, 22.6 5.2, 24.2 6.3 C 22.6 7.2, 21 8.6, 19.6 10.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
          </svg>
          {t.back}
        </a>
        <span class="hand text-xl text-ink-faint">{writtenOn} · {readMinutes} {t.minRead}</span>
      </div>

      <!-- Titre -->
      <h1 class="font-display font-extrabold tracking-tight leading-[1.08] text-4xl md:text-5xl text-ink mb-6">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="font-serif text-xl md:text-2xl leading-relaxed text-ink-soft mb-10 pl-5 border-l-[3px] border-[var(--pen)]">
          {post.data.description}
        </p>
      )}

      {post.data.cover && (
        <div class="relative paper-card tilt-1 p-3 mb-12">
          <span class="tape tape-c" aria-hidden="true"></span>
          <img src={post.data.cover} alt={post.data.title} class="w-full h-auto rounded-md" loading="eager" decoding="async" />
        </div>
      )}

      <!-- Corps -->
      <div class="prose-notebook">
        <Content />
      </div>

      <!-- Signature -->
      <div class="mt-16 flex items-center gap-4">
        <img src="/avatar-dd-96.webp" alt="" width="46" height="56" class="w-[46px] h-auto -rotate-3 block dark:hidden" />
        <img src="/avatar-dd-white.svg" alt="" width="46" height="56" class="w-[46px] h-auto -rotate-3 hidden dark:block" />
        <span class="hand text-3xl text-ink">DD</span>
        <span class="hand text-xl md:text-2xl text-pen rotate-[-3deg] border-[2.5px] border-current rounded-xl px-4 py-1 ml-auto opacity-90">
          {t.stamp}
        </span>
      </div>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-10 pt-8 border-t border-dashed border-[var(--paper-edge)] flex flex-wrap gap-2.5">
          {post.data.tags.map((tag: string) => (
            <span class="hand text-lg text-ink-soft px-3.5 py-0.5 rounded-full border border-[var(--paper-edge)] bg-[var(--paper-raised)]">#{tag}</span>
          ))}
        </div>
      )}
    </article>

    <!-- Pages liées -->
    {related.length > 0 && (
      <section class="relative max-w-6xl mx-auto px-6 md:px-12 pb-24 md:pb-32">
        <p class="hand text-2xl md:text-3xl text-pen rotate-[-1.5deg] mb-2">{t.relatedHand}</p>
        <h2 class="font-display font-extrabold tracking-tight text-2xl md:text-4xl text-ink mb-10">{t.relatedTitle}</h2>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-7 md:gap-8 list-none p-0 m-0">
          {related.map((p: any, i: number) => (
            <li>
              <a href={`/blog/${p.id}`} class:list={['paper-card group relative flex h-full flex-col p-5 md:p-6 no-underline', tilts[i % tilts.length]]}>
                <span class:list={['tape', i % 2 === 0 ? 'tape-c' : 'tape-r']} aria-hidden="true"></span>
                <p class="hand text-lg text-pen leading-none mb-2.5">
                  {fmtDateLong(p.data.date, p.data.lang)}
                </p>
                <h3 class="font-display font-semibold tracking-tight text-lg text-ink leading-snug mb-2 group-hover:text-pen transition-colors">
                  {p.data.title}
                </h3>
                {p.data.description && (
                  <p class="font-serif text-sm leading-relaxed text-ink-soft line-clamp-2 mb-4">{p.data.description}</p>
                )}
                <span class="mt-auto self-end">
                  <svg class="text-pen transition-transform duration-300 group-hover:translate-x-1.5 group-hover:-rotate-6" width="22" height="10" viewBox="0 0 26 12" fill="none" aria-hidden="true">
                    <path d="M1.5 6.5 C 8 4.5, 15 8, 22.5 6 M19.5 2.5 C 21 4, 22.6 5.2, 24.2 6.3 C 22.6 7.2, 21 8.6, 19.6 10.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
  <Footer lang={currentLang} />
</Layout>
