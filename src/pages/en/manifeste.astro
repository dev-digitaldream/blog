---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const currentLang = 'en';

const t = {
  fr: {
    hand: 'les r\u00e8gles du jeu',
    title: 'Le manifeste du carnet.',
    lead: "Pas de fiches marketing, pas d'articles sponsoris\u00e9s d\u00e9guis\u00e9s. Je teste, j'utilise et j'explique des outils tels qu'ils servent vraiment, avec leurs qualit\u00e9s et leurs limites.",
    s1: {
      num: '01.',
      title: 'Ligne \u00e9ditoriale',
      items: ['contenu \u00e9crit librement', 'aucun discours impos\u00e9', 'aucun avis achet\u00e9', 'liens affili\u00e9s toujours signal\u00e9s'],
      note: "Si un produit n'est pas pertinent, c'est dit. S'il est bon mais mal positionn\u00e9, c'est expliqu\u00e9. Et quand un lien est affili\u00e9 (Amazon par exemple), il est marqu\u00e9 comme tel : la commission \u00e9ventuelle ne change ni la note, ni l'avis.",
    },
    s2: {
      num: '02.',
      title: 'Ce que je teste',
      items: ['gadgets tech utiles en production', 'bagagerie, sacs et organisation', 'mini PC et hardware compact', 'outils logiciels orient\u00e9s efficacit\u00e9'],
      note: 'Toujours en conditions r\u00e9elles. Jamais en vitrine.',
    },
    s3: {
      num: '03.',
      title: 'Cadre de collaboration',
      possibleTitle: 'collaborations possibles',
      possible: ['pr\u00eat de mat\u00e9riel', 'acc\u00e8s anticip\u00e9', '\u00e9changes techniques'],
      condTitle: 'conditions non n\u00e9gociables',
      conditions: ['aucun droit de regard avant publication', 'aucune promesse de publication', 'mention claire quand le mat\u00e9riel est fourni'],
    },
    s4: {
      num: '04.',
      title: 'Ce que je refuse',
      items: ['sponsoring \u00e9ditorial', 'promotion d\u00e9guis\u00e9e', 'discours marketing'],
      note: "Ce carnet n'est pas une r\u00e9gie publicitaire.",
    },
    contactHand: 'un produit \u00e0 tester ?',
    contactLead: "Si ton produit supporte un regard ind\u00e9pendant, ou si ton projet colle \u00e0 cette d\u00e9marche, \u00e9cris-moi via le formulaire en bas de page.",
    cta: 'Aller au formulaire',
  },
  en: {
    hand: 'the ground rules',
    title: 'The notebook manifesto.',
    lead: "No marketing sheets, no disguised sponsored posts. I test, use, and explain tools as they're actually used, with their strengths and limits.",
    s1: {
      num: '01.',
      title: 'Editorial line',
      items: ['freely written content', 'no imposed narrative', 'no bought opinions', 'affiliate links always disclosed'],
      note: "If a product isn't relevant, I say so. If it's good but poorly positioned, I explain why. And when a link is an affiliate link (Amazon for instance), it's marked as such: the potential commission changes neither the rating nor the opinion.",
    },
    s2: {
      num: '02.',
      title: 'What I test',
      items: ['tech gadgets useful in production', 'bags, carry and organization', 'mini PCs and compact hardware', 'efficiency-focused software tools'],
      note: 'Always in real conditions. Never on display.',
    },
    s3: {
      num: '03.',
      title: 'Collaboration framework',
      possibleTitle: 'possible collaborations',
      possible: ['hardware loans', 'early access', 'technical exchanges'],
      condTitle: 'non-negotiable conditions',
      conditions: ['no editorial oversight before publication', 'no guarantee of publication', 'clear disclosure when hardware is provided'],
    },
    s4: {
      num: '04.',
      title: 'What I refuse',
      items: ['editorial sponsoring', 'disguised promotion', 'marketing narrative'],
      note: 'This notebook is not an ad agency.',
    },
    contactHand: 'a product to test?',
    contactLead: "If your product can stand an independent look, or if your project fits this approach, write to me via the form at the bottom of the page.",
    cta: 'Go to form',
  },
}[currentLang];
---

<Layout title="Manifesto · DigitalDream">
  <main class="min-h-screen text-ink relative">
    <div class="hidden lg:block absolute top-0 bottom-0 left-10 w-px bg-pen/25 pointer-events-none" aria-hidden="true"></div>
    <div class="hidden lg:block absolute top-0 bottom-0 left-[42px] w-px bg-pen/25 pointer-events-none" aria-hidden="true"></div>

    <section class="relative max-w-3xl mx-auto px-6 md:px-12 pt-16 md:pt-24 pb-12 md:pb-16">
      <p class="hand text-2xl md:text-3xl text-pen rotate-[-1.5deg] mb-3">{t.hand}</p>
      <h1 class="font-display font-extrabold tracking-tight text-4xl sm:text-5xl md:text-6xl text-ink mb-7">
        {t.title}
      </h1>
      <p class="font-serif text-xl md:text-2xl leading-relaxed text-ink-soft">{t.lead}</p>
    </section>

    <section class="relative max-w-3xl mx-auto px-6 md:px-12 pb-24 md:pb-32">
      <div class="paper-card tilt-1 relative px-7 py-10 md:px-12 md:py-14">
        <span class="tape tape-c" aria-hidden="true"></span>

        <div class="mb-12">
          <p class="hand text-2xl text-pen mb-1">{t.s1.num}</p>
          <h2 class="font-display font-bold tracking-tight text-2xl md:text-3xl text-ink mb-5">{t.s1.title}</h2>
          <ul class="space-y-3 mb-5 list-none p-0 m-0">
            {t.s1.items.map(item => (
              <li class="flex items-start gap-3 font-serif text-[17px] text-ink-soft">
                <svg class="mt-1.5 shrink-0 text-ink" width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <rect x="1.5" y="1.5" width="11" height="11" rx="3" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M4 7.4 L6.2 9.6 L10.2 4.4" stroke="var(--pen)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="font-serif text-[15px] leading-relaxed text-ink-faint border-l-[3px] border-[var(--pen)] pl-4">{t.s1.note}</p>
        </div>

        <hr class="border-none border-t-2 border-dashed border-[var(--paper-edge)] my-10" />

        <div class="mb-12">
          <p class="hand text-2xl text-pen mb-1">{t.s2.num}</p>
          <h2 class="font-display font-bold tracking-tight text-2xl md:text-3xl text-ink mb-5">{t.s2.title}</h2>
          <ul class="space-y-3 mb-5 list-none p-0 m-0">
            {t.s2.items.map(item => (
              <li class="flex items-start gap-3 font-serif text-[17px] text-ink-soft">
                <svg class="mt-1.5 shrink-0 text-ink" width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <rect x="1.5" y="1.5" width="11" height="11" rx="3" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M4 7.4 L6.2 9.6 L10.2 4.4" stroke="var(--pen)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="hand text-xl text-ink-faint rotate-[-0.5deg]">{t.s2.note}</p>
        </div>

        <hr class="border-none border-t-2 border-dashed border-[var(--paper-edge)] my-10" />

        <div class="mb-12">
          <p class="hand text-2xl text-pen mb-1">{t.s3.num}</p>
          <h2 class="font-display font-bold tracking-tight text-2xl md:text-3xl text-ink mb-5">{t.s3.title}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <div>
              <p class="hand text-xl text-ink-faint mb-3">{t.s3.possibleTitle}</p>
              <ul class="space-y-2.5 list-none p-0 m-0">
                {t.s3.possible.map(item => (
                  <li class="flex items-start gap-3 font-serif text-[17px] text-ink-soft">
                    <svg class="mt-1.5 shrink-0 text-pen" width="16" height="10" viewBox="0 0 26 12" fill="none" aria-hidden="true">
                      <path d="M1.5 6.5 C 8 4.5, 15 8, 22.5 6 M19.5 2.5 C 21 4, 22.6 5.2, 24.2 6.3 C 22.6 7.2, 21 8.6, 19.6 10.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="hand text-xl text-pen mb-3">{t.s3.condTitle}</p>
              <ul class="space-y-2.5 list-none p-0 m-0">
                {t.s3.conditions.map(item => (
                  <li class="flex items-start gap-3 font-serif text-[17px] text-ink">
                    <svg class="mt-1.5 shrink-0 text-pen" width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2 6 L5 9 L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <hr class="border-none border-t-2 border-dashed border-[var(--paper-edge)] my-10" />

        <div>
          <p class="hand text-2xl text-pen mb-1">{t.s4.num}</p>
          <h2 class="font-display font-bold tracking-tight text-2xl md:text-3xl text-ink mb-5">{t.s4.title}</h2>
          <ul class="space-y-3 mb-5 list-none p-0 m-0">
            {t.s4.items.map(item => (
              <li class="flex items-start gap-3 font-serif text-[17px] text-ink-faint">
                <svg class="mt-1.5 shrink-0 text-pen" width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 2.5 L9.5 9.5 M9.5 2.5 L2.5 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="line-through decoration-[var(--pen)] decoration-wavy decoration-2 underline-offset-4">{item}</span>
              </li>
            ))}
          </ul>
          <p class="hand text-xl text-ink-faint rotate-[0.5deg]">{t.s4.note}</p>
        </div>
      </div>

      <div class="mt-14 text-center">
        <p class="hand text-2xl md:text-3xl text-pen rotate-[-1deg] mb-4">{t.contactHand}</p>
        <p class="font-serif text-lg text-ink-soft max-w-xl mx-auto mb-8">{t.contactLead}</p>
        <a href="#contact" class="paper-card hoverable inline-flex items-center gap-2.5 px-7 py-3.5 font-display font-semibold text-sm text-ink no-underline">
          {t.cta}
          <svg class="rotate-90" width="14" height="8" viewBox="0 0 26 12" fill="none" aria-hidden="true">
            <path d="M1.5 6.5 C 8 4.5, 15 8, 22.5 6 M19.5 2.5 C 21 4, 22.6 5.2, 24.2 6.3 C 22.6 7.2, 21 8.6, 19.6 10.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
    </section>
  </main>
  <Footer lang={currentLang} />
</Layout>