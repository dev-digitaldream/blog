---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const currentLang = 'en';

const t = {
  fr: {
    hand: 'oups, page introuvable',
    title: 'Cette page n\u2019existe pas (ou plus).',
    sub: 'Elle a peut-\u00eatre \u00e9t\u00e9 d\u00e9chir\u00e9e du carnet. Revenons aux pages qui existent.',
    cta: 'Retour au carnet',
  },
  en: {
    hand: 'oops, page not found',
    title: 'This page doesn\u2019t exist (anymore).',
    sub: 'It may have been torn out of the notebook. Let\u2019s get back to the pages that exist.',
    cta: 'Back to the notebook',
  },
}[currentLang];
---

<Layout title="404 · DigitalDream">
  <main class="min-h-screen text-ink flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-lg">
      <div class="relative inline-block paper-card tilt-2 p-4 mb-8">
        <span class="tape tape-c" aria-hidden="true"></span>
        <img src="/avatar-dd.webp" alt="DD" width="220" height="268" class="w-[180px] md:w-[220px] h-auto block dark:hidden" loading="eager" />
        <img src="/avatar-dd-white.svg" alt="DD" width="220" height="268" class="w-[180px] md:w-[220px] h-auto hidden dark:block" loading="eager" />
      </div>
      <p class="hand text-2xl md:text-3xl text-pen rotate-[-1.5deg] mb-4">{t.hand}</p>
      <h1 class="font-display font-extrabold tracking-tight text-3xl md:text-5xl text-ink mb-5">{t.title}</h1>
      <p class="font-serif text-lg text-ink-soft mb-9">{t.sub}</p>
      <a href="/en/" class="paper-card hoverable inline-flex items-center gap-2.5 px-7 py-3.5 font-display font-semibold text-sm text-ink no-underline">
        <svg class="rotate-180" width="18" height="9" viewBox="0 0 26 12" fill="none" aria-hidden="true">
          <path d="M1.5 6.5 C 8 4.5, 15 8, 22.5 6 M19.5 2.5 C 21 4, 22.6 5.2, 24.2 6.3 C 22.6 7.2, 21 8.6, 19.6 10.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        {t.cta}
      </a>
    </div>
  </main>
  <Footer lang={currentLang} />
</Layout>