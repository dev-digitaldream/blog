---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getCurrentLanguage } from '../../lib/i18n';

const currentLang = getCurrentLanguage();

const projects = (await getCollection('projects'))
  .filter((p: any) => !p.data.draft && p.data.lang === currentLang)
  .sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());

const t = {
  fr: { label: 'WORKS — TOUS LES PROJETS', title: 'Projets', sub: 'Outils et expérimentations en développement.' },
  en: { label: 'WORKS — ALL PROJECTS', title: 'Works', sub: 'Tools and experiments in development.' },
}[currentLang];

function fmtDate(d: Date | string, lang: string) {
  return new Date(d).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
    day: '2-digit', month: 'short', year: 'numeric',
  });
}
---

<Layout title={`${t.title} — DigitalDream`}>
  <main class="min-h-screen">
    <section class="px-6 md:px-12 pt-20 md:pt-32 pb-12 md:pb-20">
      <div class="max-w-7xl mx-auto">
        <span class="font-mono text-[11px] tracking-[0.2em] text-neutral-500 dark:text-neutral-500 block mb-6">
          {t.label}
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-medium tracking-tight leading-[1.05] text-neutral-900 dark:text-neutral-50">
          <span class="font-serif italic font-normal">{t.title}</span>
        </h1>
        <p class="mt-6 text-base text-neutral-600 dark:text-neutral-400 max-w-md">{t.sub}</p>
      </div>
    </section>

    <section class="border-t border-neutral-300/70 dark:border-neutral-700/70">
      {projects.length === 0 ? (
        <div class="max-w-7xl mx-auto px-6 md:px-12 py-20 text-center font-mono text-sm text-neutral-500">
          {currentLang === 'fr' ? 'Aucun projet pour le moment.' : 'No projects yet.'}
        </div>
      ) : (
        <ul class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-px bg-neutral-300/70 dark:bg-neutral-700/70">
          {projects.map((project: any, idx: number) => (
            <li class="bg-stone-50 dark:bg-neutral-900">
              <a href={`/projects/${project.id}`} class="block p-8 md:p-10 hover:bg-white dark:hover:bg-neutral-950 transition-colors h-full">
                <div class="flex items-start justify-between mb-6 font-mono text-[11px] tracking-widest text-neutral-500 dark:text-neutral-500">
                  <span>({String(idx + 1).padStart(2, '0')})</span>
                  <span>{fmtDate(project.data.date, currentLang)}</span>
                </div>
                <h3 class="text-2xl md:text-3xl font-medium tracking-tight text-neutral-900 dark:text-neutral-100 leading-tight mb-3">
                  <span class="link-hover">{project.data.title}</span>
                </h3>
                {project.data.description && (
                  <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-md">{project.data.description}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
  <Footer />
</Layout>
