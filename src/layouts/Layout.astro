---
import '../styles/global.css';
import '@fontsource/sora/400.css';
import '@fontsource/sora/500.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource-variable/fraunces';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import LanguageSelector from '../components/LanguageSelector.astro';
import LanguageSuggest from '../components/LanguageSuggest.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Search from '../components/Search.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  lang?: 'fr' | 'en';
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  tags?: string[];
  translationSlug?: string;
  headline?: string;
  wordCount?: number;
  readingMinutes?: number;
  category?: string;
  alternatePath?: string;
}

const lang = Astro.props.lang ?? (Astro.url.pathname.startsWith('/en') ? 'en' : 'fr');
const prefix = lang === 'en' ? '/en' : '';

const fallbackDesc = lang === 'en' ? "Personal blog about web dev, self-hosting, gadgets and infrastructure." : "Blog technique sur le développement web, l'auto-hébergement et l'infrastructure moderne.";

const {
  title,
  description = fallbackDesc,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'DD',
  tags = [],
  translationSlug,
  headline,
  wordCount,
  readingMinutes,
  category,
  alternatePath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).toString();
const publishedPosts = type === 'article' ? await getCollection('blog', ({ data }) => !data.draft) : [];
const counterpart = publishedPosts.find((post) =>
  post.id === translationSlug && post.data.lang !== lang
);
const articleAlternates = counterpart ? [
  { lang: lang === 'en' ? 'en-US' : 'fr-FR', url: canonicalURL },
  { lang: counterpart.data.lang === 'en' ? 'en-US' : 'fr-FR', url: new URL(`/blog/${counterpart.id}/`, Astro.site) },
] : [];
const staticAlternatePaths: Record<string, { fr: string; en: string }> = {
  '/': { fr: '/', en: '/en/' },
  '/en/': { fr: '/', en: '/en/' },
  '/blog/': { fr: '/blog/', en: '/en/blog/' },
  '/en/blog/': { fr: '/blog/', en: '/en/blog/' },
  '/projects/': { fr: '/projects/', en: '/en/projects/' },
  '/en/projects/': { fr: '/projects/', en: '/en/projects/' },
  '/manifeste/': { fr: '/manifeste/', en: '/en/manifeste/' },
  '/en/manifeste/': { fr: '/manifeste/', en: '/en/manifeste/' },
  '/commencer/': { fr: '/commencer/', en: '/en/start-here/' },
  '/en/start-here/': { fr: '/commencer/', en: '/en/start-here/' },
  '/sujets/': { fr: '/sujets/', en: '/en/topics/' },
  '/en/topics/': { fr: '/sujets/', en: '/en/topics/' },
  '/partenariats/': { fr: '/partenariats/', en: '/en/partnerships/' },
  '/en/partnerships/': { fr: '/partenariats/', en: '/en/partnerships/' },
};
const staticPair = staticAlternatePaths[Astro.url.pathname];
const staticAlternates = staticPair ? [
  { lang: 'fr-FR', url: new URL(staticPair.fr, Astro.site) },
  { lang: 'en-US', url: new URL(staticPair.en, Astro.site) },
] : [];
const customAlternates = alternatePath ? [
  { lang: lang === 'en' ? 'en-US' : 'fr-FR', url: canonicalURL },
  { lang: lang === 'en' ? 'fr-FR' : 'en-US', url: new URL(alternatePath, Astro.site) },
] : [];
const languageAlternates = articleAlternates.length > 0 ? articleAlternates : customAlternates.length > 0 ? customAlternates : staticAlternates;
const defaultLanguageURL = languageAlternates.find((alternate) => alternate.lang === 'fr-FR')?.url;
const siteURL = Astro.site?.toString() ?? 'https://blog.digitaldream.work/';
const organizationId = `${siteURL}#organization`;
const authorId = `${siteURL}#author`;
const websiteId = `${siteURL}#website`;
const organizationNode = {
  '@type': 'Organization',
  '@id': organizationId,
  name: 'DigitalDream',
  url: siteURL,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/avatar-dd.png', Astro.site).toString(),
    width: 800,
    height: 972,
  },
};
const authorNode = {
  '@type': 'Person',
  '@id': authorId,
  name: author,
  url: new URL('/manifeste/', Astro.site).toString(),
  image: new URL('/avatar-dd.png', Astro.site).toString(),
  worksFor: { '@id': organizationId },
};

// JSON-LD structured data
const jsonLD = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          '@id': `${canonicalURL.toString()}#article`,
          headline: headline || title,
          inLanguage: lang === 'en' ? 'en-US' : 'fr-FR',
          description,
          image: ogImage,
          datePublished: publishedTime,
          dateModified: modifiedTime || publishedTime,
          author: { '@id': authorId },
          publisher: { '@id': organizationId },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
          keywords: tags.join(', '),
          ...(category ? { articleSection: category } : {}),
          ...(wordCount ? { wordCount } : {}),
          ...(readingMinutes ? { timeRequired: `PT${readingMinutes}M` } : {}),
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonicalURL.toString()}#breadcrumb`,
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: lang === 'en' ? 'The notebook' : 'Le carnet',
              item: new URL(lang === 'en' ? '/en/' : '/', Astro.site).toString(),
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: lang === 'en' ? 'Articles' : 'Articles',
              item: new URL(lang === 'en' ? '/en/blog/' : '/blog/', Astro.site).toString(),
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: headline || title,
              item: canonicalURL.toString(),
            },
          ],
        },
        authorNode,
        organizationNode,
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': websiteId,
          name: 'DigitalDream',
          url: siteURL,
          description: fallbackDesc,
          inLanguage: ['fr-FR', 'en-US'],
          publisher: { '@id': organizationId },
        },
        {
          '@type': 'WebPage',
          '@id': canonicalURL.toString(),
          url: canonicalURL.toString(),
          name: title,
          description,
          inLanguage: lang === 'en' ? 'en-US' : 'fr-FR',
          isPartOf: { '@id': websiteId },
          author: { '@id': authorId },
        },
        authorNode,
        organizationNode,
      ],
    };
---

<!doctype html>
    <html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f5eeda" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1f31" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="Carnet DD" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <LanguageSuggest lang={lang} />
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="author" href={lang === 'en' ? '/en/manifeste/' : '/manifeste/'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {languageAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.url} />
    ))}
    {defaultLanguageURL && <link rel="alternate" hreflang="x-default" href={defaultLanguageURL} />}
    <link rel="alternate" type="application/rss+xml" title={lang === 'en' ? 'DigitalDream · The notebook' : 'DigitalDream · Le carnet'} href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={headline || title} />
    <meta property="og:site_name" content="DigitalDream" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'fr_FR'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'fr_FR' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
    {type === 'article' && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={headline || title} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />

    <!-- View Transitions API -->
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        const favicon = document.getElementById('favicon');
        if (favicon) favicon.href = isDark ? '/avatar-dd-white.svg' : '/favicon-light.svg';
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);

      function headingAnchorCopy() {
        document.querySelectorAll('.heading-anchor').forEach(a => {
          a.addEventListener('click', e => {
            e.preventDefault();
            const url = new URL(window.location.href);
            url.hash = a.parentElement?.id || '';
            navigator.clipboard?.writeText(url.toString());
          });
        });
      }
      document.addEventListener('astro:page-load', headingAnchorCopy);
      headingAnchorCopy();

      if (!window.avatarSparkBound) {
        document.addEventListener('click', event => {
          const portrait = event.target.closest?.('[data-avatar-spark]');
          if (!portrait) return;
          portrait.classList.remove('is-popping');
          void portrait.offsetWidth;
          portrait.classList.add('is-popping');
          window.setTimeout(() => portrait.classList.remove('is-popping'), 620);
        });
        window.avatarSparkBound = true;
      }
    </script>
  </head>
  <body class="bg-notebook grain text-neutral-900 dark:text-neutral-100">
    <header class="fixed top-3 md:top-4 left-0 right-0 z-50 px-4 md:px-8">
      <div class="max-w-5xl mx-auto flex justify-between items-center gap-4 pl-4 pr-3 py-2 rounded-full border border-[var(--paper-edge)] bg-[var(--paper-raised)]/85 dark:bg-[var(--paper-raised)]/85 backdrop-blur-xl shadow-[0_2px_14px_rgba(45,36,12,0.10)]">
        <a href={prefix || '/'} class="flex items-center gap-2.5 no-underline whitespace-nowrap">
          <img src="/avatar-dd-96.webp" alt="" width="30" height="37" class="w-[30px] h-auto -rotate-3 block dark:hidden" />
          <img src="/avatar-dd-white.svg" alt="" width="30" height="37" class="w-[30px] h-auto -rotate-3 hidden dark:block" />
          <span class="font-display font-bold text-[15px] tracking-tight text-[var(--ink)]">digitaldream</span>
          <span class="hand text-lg leading-none text-[var(--pen)] -ml-1 mt-1 hidden sm:inline">{lang === 'en' ? 'the notebook' : 'le carnet'}</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 font-sans text-[13px] font-medium text-[var(--ink-soft)]">
          <a
            href="/random"
            aria-label={lang === 'en' ? 'Open a random article' : 'Ouvrir un article au hasard'}
            class="hover:text-[var(--pen)] transition-colors"
          >🎲</a>
          <a href={`${prefix}/blog`} class="hover:text-[var(--pen)] transition-colors">notes</a>
          <a href={`${prefix}/projects`} class="hover:text-[var(--pen)] transition-colors">works</a>
          <a href={`${prefix}/manifeste`} class="hover:text-[var(--pen)] transition-colors">{lang === 'en' ? 'manifesto' : 'manifeste'}</a>
          <a href="#contact" class="hover:text-[var(--pen)] transition-colors">contact</a>
        </nav>
        <div class="flex items-center gap-2 md:gap-3 text-[var(--ink-soft)]">
          <Search lang={lang} />
          <ThemeToggle />
          <LanguageSelector lang={lang} translationSlug={translationSlug} />
        </div>
      </div>
    </header>
    <div class="pt-20">
      <slot />
    </div>
  </body>
</html>
