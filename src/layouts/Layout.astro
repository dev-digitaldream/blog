---
import '../styles/global.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import LanguageSelector from '../components/LanguageSelector.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Search from '../components/Search.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description = "Blog technique sur le développement web, l'auto-hébergement et l'infrastructure moderne.",
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Mohammed',
  tags = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).toString();

// JSON-LD structured data
const jsonLD = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      dateModified: modifiedTime || publishedTime,
      author: { '@type': 'Person', name: author },
      publisher: {
        '@type': 'Organization',
        name: 'DigitalDream',
        logo: { '@type': 'ImageObject', url: new URL('/favicon-light.svg', Astro.site).toString() },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
      keywords: tags.join(', '),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'DigitalDream',
      url: Astro.site?.toString(),
      description,
      inLanguage: 'fr-FR',
    };
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="DigitalDream Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="DigitalDream" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:locale:alternate" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
    {type === 'article' && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />

    <!-- View Transitions API -->
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      }
      applyTheme();
      // Re-applique après navigation via ClientRouter (View Transitions)
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-stone-50 dark:bg-neutral-900 text-neutral-900 dark:text-white">
    <header class="fixed top-0 left-0 right-0 z-50 px-6 md:px-12 py-5 bg-stone-50/80 dark:bg-neutral-900/80 backdrop-blur-xl border-b border-neutral-300/60 dark:border-neutral-700/60">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="font-sans text-base font-semibold tracking-tight text-neutral-900 dark:text-white">
          DigitalDream
        </a>
        <nav class="hidden md:flex items-center gap-8 font-mono text-[11px] tracking-widest uppercase text-neutral-600 dark:text-neutral-400">
          <a href="/blog" class="link-hover">I — Blog</a>
          <a href="/projects" class="link-hover">II — Works</a>
          <a href="/manifeste" class="link-hover">III — Manifeste</a>
          <a href="#contact" class="link-hover">IV — Contact</a>
        </nav>
        <div class="flex items-center gap-3 md:gap-4">
          <Search />
          <ThemeToggle />
          <LanguageSelector />
        </div>
      </div>
    </header>
    <main class="pt-20">
      <slot />
    </main>
  </body>
</html>
