---
import '../styles/global.css';
import '@fontsource/sora/400.css';
import '@fontsource/sora/500.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource-variable/fraunces';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import LanguageSelector from '../components/LanguageSelector.astro';
import LanguageSuggest from '../components/LanguageSuggest.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Search from '../components/Search.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  tags?: string[];
  translationSlug?: string;
}

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'fr';
const prefix = lang === 'en' ? '/en' : '';

const fallbackDesc = lang === 'en' ? "Personal blog about web dev, self-hosting, gadgets and infrastructure." : "Blog technique sur le développement web, l'auto-hébergement et l'infrastructure moderne.";

const {
  title,
  description = fallbackDesc,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'DigitalDream',
  tags = [],
  translationSlug,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).toString();

// JSON-LD structured data
const jsonLD = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      dateModified: modifiedTime || publishedTime,
      author: { '@type': 'Person', name: author },
      publisher: {
        '@type': 'Organization',
        name: 'DigitalDream',
        logo: { '@type': 'ImageObject', url: new URL('/favicon-light.svg', Astro.site).toString() },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
      keywords: tags.join(', '),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'DigitalDream',
      url: Astro.site?.toString(),
      description,
      inLanguage: lang === 'en' ? 'en-US' : 'fr-FR',
    };
---

<!doctype html>
    <html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="DigitalDream Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="DigitalDream" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'fr_FR'} />
    <meta property="og:locale:alternate" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
    {type === 'article' && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />

    <!-- View Transitions API -->
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
        const favicon = document.getElementById('favicon');
        if (favicon) favicon.href = isDark ? '/avatar-dd-white.svg' : '/favicon-light.svg';
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);

      function headingAnchorCopy() {
        document.querySelectorAll('.heading-anchor').forEach(a => {
          a.addEventListener('click', e => {
            e.preventDefault();
            const url = new URL(window.location.href);
            url.hash = a.parentElement?.id || '';
            navigator.clipboard?.writeText(url.toString());
          });
        });
      }
      document.addEventListener('astro:page-load', headingAnchorCopy);
      headingAnchorCopy();
    </script>
  </head>
  <body class="bg-notebook grain text-neutral-900 dark:text-neutral-100">
    <LanguageSuggest translationSlug={translationSlug} />
    <header class="fixed top-3 md:top-4 left-0 right-0 z-50 px-4 md:px-8">
      <div class="max-w-5xl mx-auto flex justify-between items-center gap-4 pl-4 pr-3 py-2 rounded-full border border-[var(--paper-edge)] bg-[var(--paper-raised)]/85 dark:bg-[var(--paper-raised)]/85 backdrop-blur-xl shadow-[0_2px_14px_rgba(45,36,12,0.10)]">
        <a href={prefix || '/'} class="flex items-center gap-2.5 no-underline whitespace-nowrap">
          <img src="/avatar-dd-96.webp" alt="" width="30" height="37" class="w-[30px] h-auto -rotate-3 block dark:hidden" />
          <img src="/avatar-dd-white.svg" alt="" width="30" height="37" class="w-[30px] h-auto -rotate-3 hidden dark:block" />
          <span class="font-display font-bold text-[15px] tracking-tight text-[var(--ink)]">digitaldream</span>
          <span class="hand text-lg leading-none text-[var(--pen)] -ml-1 mt-1 hidden sm:inline">{lang === 'en' ? 'the notebook' : 'le carnet'}</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 font-sans text-[13px] font-medium text-[var(--ink-soft)]">
          <a href="/random" class="hover:text-[var(--pen)] transition-colors">🎲</a>
          <a href={`${prefix}/blog`} class="hover:text-[var(--pen)] transition-colors">notes</a>
          <a href={`${prefix}/projects`} class="hover:text-[var(--pen)] transition-colors">works</a>
          <a href={`${prefix}/manifeste`} class="hover:text-[var(--pen)] transition-colors">{lang === 'en' ? 'manifesto' : 'manifeste'}</a>
          <a href="#contact" class="hover:text-[var(--pen)] transition-colors">contact</a>
        </nav>
        <div class="flex items-center gap-2 md:gap-3 text-[var(--ink-soft)]">
          <Search />
          <ThemeToggle />
          <LanguageSelector translationSlug={translationSlug} />
        </div>
      </div>
    </header>
    <main class="pt-20">
      <slot />
    </main>
  </body>
</html>
