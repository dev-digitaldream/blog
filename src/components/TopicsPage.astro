---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { topics, topicPath, type TopicLanguage } from '../lib/topics';

interface Props { lang: TopicLanguage }
const { lang } = Astro.props;
const copy = lang === 'fr' ? {
  title: 'Les sujets du carnet',
  description: 'Les principaux sujets du Carnet de DD : outils Apple, auto-hébergement, IA appliquée, sécurité et développement.',
  eyebrow: 'quelques chemins dans le carnet',
  intro: 'Ces pages regroupent les notes par expérience et par usage. Elles évolueront avec le carnet, sans transformer chaque idée en rubrique artificielle.',
  count: (n: number) => `${n} note${n > 1 ? 's' : ''}`,
} : {
  title: 'Topics in the notebook',
  description: 'The main topics in DD’s notebook: Apple tools, self-hosting, applied AI, security, and development.',
  eyebrow: 'a few paths through the notebook',
  intro: 'These pages bring notes together by experience and use. They will grow with the notebook, without turning every idea into an artificial category.',
  count: (n: number) => `${n} note${n > 1 ? 's' : ''}`,
};
---

<Layout title={`${copy.title} · DigitalDream`} description={copy.description} lang={lang}>
  <main class="min-h-screen text-ink">
    <section class="max-w-5xl mx-auto px-6 md:px-12 pt-16 md:pt-24 pb-20">
      <p class="hand text-2xl md:text-3xl text-pen -rotate-1 mb-4">{copy.eyebrow}</p>
      <h1 class="font-display font-extrabold tracking-tight text-4xl md:text-6xl mb-6">{copy.title}</h1>
      <p class="font-serif text-lg md:text-xl leading-relaxed text-ink-soft max-w-3xl mb-14">{copy.intro}</p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-7 list-none p-0 m-0">
        {topics[lang].map((topic, index) => (
          <li>
            <a href={topicPath(lang, topic.slug)} class:list={['paper-card group relative block h-full p-7 no-underline', `tilt-${(index % 4) + 1}`]}>
              <span class:list={['tape', index % 2 ? 'tape-r' : 'tape-c']} aria-hidden="true"></span>
              <p class="hand text-xl text-pen mb-2">{topic.eyebrow}</p>
              <h2 class="font-display font-bold text-2xl leading-tight mb-3 group-hover:text-pen transition-colors">{topic.title}</h2>
              <p class="font-serif leading-relaxed text-ink-soft mb-5">{topic.description}</p>
              <span class="font-sans text-xs tracking-wide text-ink-faint">{copy.count(topic.postIds.length)} →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
