---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getCollection } from 'astro:content';
import { topicPath, type TopicDefinition, type TopicLanguage } from '../lib/topics';

interface Props { lang: TopicLanguage; topic: TopicDefinition }
const { lang, topic } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === lang);
const postMap = new Map(allPosts.map((post) => [post.id, post]));
const posts = topic.postIds.map((id) => postMap.get(id)).filter(Boolean);
const listPath = lang === 'en' ? '/en/topics/' : '/sujets/';
const counterpartPath = topicPath(lang === 'en' ? 'fr' : 'en', topic.counterpart);
const copy = lang === 'fr' ? {
  back: 'Tous les sujets',
  intro: 'Notes à lire sur ce sujet',
  more: 'Lire la note',
  description: `${topic.description} Retrouvez les notes et retours d’expérience du Carnet de DD sur ce sujet.`,
} : {
  back: 'All topics',
  intro: 'Notes to read on this topic',
  more: 'Read the note',
  description: `${topic.description} Read DD’s field notes and first-hand accounts on this topic.`,
};
---

<Layout title={`${topic.title} · DigitalDream`} description={copy.description} lang={lang} alternatePath={counterpartPath}>
  <main class="min-h-screen text-ink">
    <article class="max-w-4xl mx-auto px-6 md:px-12 pt-16 md:pt-24 pb-20">
      <a href={listPath} class="hand text-xl text-pen no-underline hover:underline">← {copy.back}</a>
      <header class="mt-9 mb-14">
        <p class="hand text-2xl md:text-3xl text-pen -rotate-1 mb-4">{topic.eyebrow}</p>
        <h1 class="font-display font-extrabold tracking-tight text-4xl md:text-6xl leading-tight mb-6">{topic.title}</h1>
        <p class="font-serif text-lg md:text-xl leading-relaxed text-ink-soft max-w-3xl">{topic.description}</p>
      </header>
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-8">{copy.intro}</h2>
      <ol class="space-y-7 list-none p-0 m-0">
        {posts.map((post, index) => post && (
          <li>
            <a href={`/blog/${post.id}/`} class:list={['paper-card group relative block p-6 md:p-8 no-underline', `tilt-${(index % 4) + 1}`]}>
              <span class:list={['tape', index % 2 ? 'tape-r' : 'tape-l']} aria-hidden="true"></span>
              <time class="hand text-lg text-pen" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long' })}
              </time>
              <h3 class="font-display font-bold text-xl md:text-2xl leading-snug mt-2 mb-3 group-hover:text-pen transition-colors">{post.data.title}</h3>
              <p class="font-serif leading-relaxed text-ink-soft">{post.data.description}</p>
              <span class="inline-block mt-4 font-sans text-xs font-semibold tracking-wide text-pen">{copy.more} →</span>
            </a>
          </li>
        ))}
      </ol>
    </article>
  </main>
  <Footer lang={lang} />
</Layout>
