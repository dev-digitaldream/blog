---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import type { TopicLanguage } from '../lib/topics';

interface Props { lang: TopicLanguage }
const { lang } = Astro.props;
const copy = lang === 'fr' ? {
  title: 'Partenariats et tests de terrain',
  description: 'Proposer un produit ou un service tech au Carnet de DD : conditions de test, indépendance éditoriale, transparence et prise de contact.',
  eyebrow: 'travailler ensemble, clairement',
  intro: 'Le Carnet de DD peut recevoir du matériel, essayer un service ou documenter un outil. Chaque sujet doit correspondre à un usage réel et laisser assez de temps pour produire un retour utile.',
  suitable: 'Ce qui trouve sa place ici',
  suitableItems: [
    ['Matériel utile sur le terrain', 'Accessoires mobiles, réseau, stockage, charge, bagagerie et outils qui peuvent réellement accompagner une journée de travail.'],
    ['Logiciels et infrastructure', 'Outils pour macOS et iOS, services auto-hébergés, hébergement, développement, sécurité et administration de systèmes.'],
    ['Projets qui méritent du temps', 'Produits encore jeunes, idées originales et solutions techniques qui gagnent à être testées au-delà d’une fiche produit.'],
  ],
  rules: 'Les règles restent simples',
  rulesItems: [
    'Recevoir un produit ne garantit ni un article ni un avis positif.',
    'Le contenu et la conclusion restent indépendants.',
    'Un prêt, un cadeau ou un lien affilié est indiqué clairement.',
    'Aucun article publicitaire déguisé ni texte imposé ne sera publié.',
    'Les défauts rencontrés sont décrits avec le même soin que les qualités.',
  ],
  contact: 'Proposer un test ou un projet',
  contactText: 'Le message peut présenter le produit, son usage attendu, les délais éventuels et les conditions proposées. Une réponse directe sera envoyée si le sujet correspond au carnet.',
  button: 'Écrire à DD',
} : {
  title: 'Partnerships and field testing',
  description: 'Propose a tech product or service to DD’s notebook: testing conditions, editorial independence, disclosure, and direct contact.',
  eyebrow: 'working together, clearly',
  intro: 'DD’s notebook can receive hardware, try a service, or document a tool. Every subject must match a real use case and allow enough time to produce a useful account.',
  suitable: 'What belongs here',
  suitableItems: [
    ['Useful field hardware', 'Mobile accessories, networking, storage, charging, bags, and tools that can genuinely support a working day.'],
    ['Software and infrastructure', 'Tools for macOS and iOS, self-hosted services, hosting, development, security, and system administration.'],
    ['Projects worth spending time on', 'Young products, original ideas, and technical solutions that deserve more than a specification-sheet review.'],
  ],
  rules: 'The rules remain simple',
  rulesItems: [
    'Receiving a product guarantees neither an article nor a positive review.',
    'The content and conclusion remain editorially independent.',
    'Loans, gifts, and affiliate links are disclosed clearly.',
    'No disguised advertising or imposed copy will be published.',
    'Problems encountered receive the same attention as strengths.',
  ],
  contact: 'Propose a review or project',
  contactText: 'The message can introduce the product, its intended use, any timing constraints, and the proposed terms. A direct reply will follow when the subject fits the notebook.',
  button: 'Write to DD',
};
---

<Layout title={`${copy.title} · DigitalDream`} description={copy.description} lang={lang}>
  <main class="min-h-screen text-ink">
    <article class="max-w-5xl mx-auto px-6 md:px-12 pt-16 md:pt-24 pb-20">
      <header class="max-w-4xl mb-16">
        <p class="hand text-2xl md:text-3xl text-pen -rotate-1 mb-4">{copy.eyebrow}</p>
        <h1 class="font-display font-extrabold tracking-tight text-4xl md:text-6xl leading-tight mb-6">{copy.title}</h1>
        <p class="font-serif text-lg md:text-xl leading-relaxed text-ink-soft">{copy.intro}</p>
      </header>

      <section class="mb-16">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-8">{copy.suitable}</h2>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-7 list-none p-0 m-0">
          {copy.suitableItems.map(([title, text], index) => (
            <li class:list={['paper-card relative p-6', `tilt-${index + 1}`]}>
              <span class:list={['tape', index % 2 ? 'tape-r' : 'tape-c']} aria-hidden="true"></span>
              <p class="hand text-2xl text-pen mb-2">0{index + 1}</p>
              <h3 class="font-display font-bold text-xl leading-snug mb-3">{title}</h3>
              <p class="font-serif text-sm leading-relaxed text-ink-soft">{text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start mb-16">
        <h2 class="md:col-span-5 font-display font-bold text-2xl md:text-3xl">{copy.rules}</h2>
        <ul class="md:col-span-7 space-y-4 font-serif text-base md:text-lg leading-relaxed text-ink-soft m-0 pl-6 marker:text-[var(--pen)]">
          {copy.rulesItems.map((rule) => <li>{rule}</li>)}
        </ul>
      </section>

      <aside class="paper-card relative p-7 md:p-10 tilt-1">
        <span class="tape tape-l" aria-hidden="true"></span>
        <p class="hand text-2xl text-pen mb-2">{copy.contact}</p>
        <p class="font-serif text-lg leading-relaxed text-ink-soft max-w-3xl mb-6">{copy.contactText}</p>
        <a href="#contact" onclick="document.querySelector('#contact')?.scrollIntoView({behavior:'smooth'}); return false;" class="inline-flex paper-card hoverable px-6 py-3 font-display font-semibold text-sm text-ink no-underline">{copy.button} →</a>
      </aside>
    </article>
  </main>
  <Footer lang={lang} />
</Layout>
