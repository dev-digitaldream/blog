---
export interface Props {
  translationSlug?: string;
  lang?: 'fr' | 'en';
}
const { translationSlug } = Astro.props;
const lang = Astro.props.lang ?? (Astro.url.pathname.startsWith('/en') ? 'en' : 'fr');
---

<div
  id="lang-suggest"
  data-translation={translationSlug}
  data-current={lang}
  hidden
></div>

<script>
  (function () {
    const el = document.getElementById('lang-suggest');
    if (!el) return;

    const current = window.location.pathname;
    if (current !== '/' && current !== '/en/') return;

    const pageLang = el.dataset.current;
    let manualChoice = null;
    try { manualChoice = localStorage.getItem('site-language-choice'); } catch {}
    const browserIsFrench = (navigator.language || '').toLowerCase().startsWith('fr');
    const preferredLang = manualChoice === 'fr' || manualChoice === 'en'
      ? manualChoice
      : browserIsFrench ? 'fr' : 'en';
    if (preferredLang === pageLang) return;

    const target = preferredLang === 'en' ? '/en/' : '/';

    if (target && target !== current) window.location.replace(target);
  })();
</script>
