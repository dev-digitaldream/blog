---
export interface Props {
  translationSlug?: string;
}
const { translationSlug } = Astro.props;
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'fr';
const dataSlug = translationSlug ? `data-translation="${translationSlug}"` : '';
---

<div
  id="lang-suggest"
  role="status"
  aria-live="polite"
  {dataSlug}
  data-current={lang}
  class="hidden fixed top-0 left-0 right-0 z-[999] px-4 py-3 bg-[var(--paper)] border-b-2 border-[var(--pen)] shadow-lg"
>
  <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
    <p class="hand text-lg md:text-xl text-ink" id="lang-suggest-msg"></p>
    <div class="flex items-center gap-3 shrink-0">
      <a id="lang-suggest-link" class="paper-card hoverable px-4 py-1.5 font-display font-semibold text-sm text-ink no-underline"></a>
      <button id="lang-suggest-close" type="button" class="hand text-xl text-ink-faint hover:text-pen transition-colors" aria-label="Dismiss">&times;</button>
    </div>
  </div>
</div>

<script>
  (function () {
    const el = document.getElementById('lang-suggest');
    const msg = document.getElementById('lang-suggest-msg');
    const link = document.getElementById('lang-suggest-link');
    const close = document.getElementById('lang-suggest-close');
    if (!el || !msg || !link || !close) return;

    const pageLang = el.dataset.current;
    const dismissed = localStorage.getItem('lang-suggest-dismissed');
    if (dismissed === '1') return;

    const browserLang = (navigator.language || '').split('-')[0];
    if (browserLang === pageLang) return;
    if (!['fr', 'en'].includes(browserLang)) return;

    const translationSlug = el.dataset.translation;
    const isEn = pageLang === 'fr' && browserLang === 'en';
    const isFr = pageLang === 'en' && browserLang === 'fr';
    if (!isEn && !isFr) return;

    if (isEn) {
      msg.textContent = 'This page is also available in English.';
      link.textContent = 'See in English';
    } else {
      msg.textContent = 'Cette page existe aussi en français.';
      link.textContent = 'Voir en français';
    }

    if (translationSlug) {
      link.href = `/blog/${translationSlug}`;
    } else if (isEn) {
      link.href = '/en' + window.location.pathname.replace(/\/+$/, '');
    } else {
      link.href = window.location.pathname.replace(/^\/en/, '') || '/';
    }

    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.location.href = link.href;
    });

    close.addEventListener('click', () => {
      localStorage.setItem('lang-suggest-dismissed', '1');
      el.classList.add('hidden');
      el.classList.remove('flex');
    });

    el.classList.remove('hidden');
    el.classList.add('flex');
  })();
</script>