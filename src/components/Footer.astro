---
export interface Props {
  lang?: 'fr' | 'en';
}
const { lang: _lang } = Astro.props;
const currentLang = _lang || 'fr';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const translations = {
  fr: {
    hand: 'écris-moi',
    nameLabel: "Nom",
    emailLabel: "Email",
    messageLabel: "Message",
    sendButton: "Envoyer",
    copyright: "Tous droits réservés.",
    handWritten: "écrit à la main par DD",
  },
  en: {
    hand: 'write to me',
    nameLabel: "Name",
    emailLabel: "Email",
    messageLabel: "Message",
    sendButton: "Send",
    copyright: "All rights reserved.",
    handWritten: "handwritten by DD",
  },
};

const t = translations[currentLang];
---

<footer id="contact" class="bg-notebook text-ink border-t border-[var(--paper-edge)]">

  <!-- CTA + Formulaire -->
  <div class="px-6 md:px-12 py-20 md:py-28 max-w-6xl mx-auto">

      <!-- Label + grand titre -->
      <div class="mb-14 md:mb-20">
        <p class="hand text-2xl md:text-3xl text-pen rotate-[-1.5deg] mb-4">{t.hand}</p>
        <h2 class="font-display font-extrabold tracking-tight text-4xl md:text-6xl leading-[1.05] max-w-4xl text-ink">
          {currentLang === 'fr' ? (
            <>Une question, une idée,<br />ou juste <span class="u-hand">envie d'échanger&nbsp;?</span></>
          ) : (
            <>A question, an idea,<br />or just <span class="u-hand">want to chat</span>?</>
          )}
        </h2>
      </div>

      <!-- Grille contact -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">

        <!-- Colonne gauche : description -->
        <div class="md:col-span-4 space-y-8">
          <div>
            <p class="hand text-xl text-pen mb-2">01.</p>
            <p class="font-serif text-base leading-relaxed text-ink-soft max-w-sm">
              {currentLang === 'fr'
                ? "Pas de réseaux sociaux. Juste un formulaire direct. Je réponds à chaque message personnellement."
                : "No social media. Just a direct form. I respond to every message personally."}
            </p>
          </div>
          <div>
            <p class="hand text-xl text-pen mb-2">02.</p>
            <p class="font-serif text-sm leading-relaxed text-ink-faint max-w-sm">
              {currentLang === 'fr'
                ? "Pour parler d'un projet, signaler une erreur dans un article, proposer un produit à tester, ou juste discuter."
                : "To discuss a project, report an error in an article, propose a product for review, or just chat."}
            </p>
          </div>
        </div>

        <!-- Colonne droite : formulaire -->
        <form
          id="footer-contact-form"
          class="md:col-span-8 space-y-0 border-t border-[var(--paper-edge)]"
          data-contact-form
          data-lang={currentLang}
          data-sitekey={turnstileSiteKey}
        >
          <!-- Honeypot (invisible aux humains, visible aux bots) -->
          <input
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;opacity:0;pointer-events:none"
          />
          <!-- Champ piège secondaire -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;opacity:0;pointer-events:none"
          />

          <div class="grid grid-cols-1 sm:grid-cols-2">
            <label class="group block py-5 border-b border-[var(--paper-edge)] sm:border-r">
              <span class="font-sans text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-faint block mb-2">{t.nameLabel}</span>
              <input
                type="text"
                name="name"
                maxlength="100"
                required
                placeholder="Jane Doe"
                class="w-full bg-transparent border-0 p-0 font-serif text-lg md:text-xl text-ink placeholder-[var(--ink-faint)] focus:outline-none focus:ring-0"
              />
            </label>
            <label class="group block py-5 border-b border-[var(--paper-edge)] sm:pl-6">
              <span class="font-sans text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-faint block mb-2">{t.emailLabel}</span>
              <input
                type="email"
                name="email"
                maxlength="254"
                required
                placeholder="hello@email.com"
                class="w-full bg-transparent border-0 p-0 font-serif text-lg md:text-xl text-ink placeholder-[var(--ink-faint)] focus:outline-none focus:ring-0"
              />
            </label>
          </div>
          <label class="group block py-5 border-b border-[var(--paper-edge)]">
            <span class="font-sans text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-faint block mb-2">{t.messageLabel}</span>
            <textarea
              name="message"
              minlength="10"
              maxlength="5000"
              required
              rows="4"
              placeholder={currentLang === 'fr' ? "Dites-moi tout..." : "Tell me everything..."}
              class="w-full bg-transparent border-0 p-0 font-serif text-lg md:text-xl text-ink placeholder-[var(--ink-faint)] focus:outline-none focus:ring-0 resize-none"
            ></textarea>
          </label>
          <div data-contact-challenge class="pt-4"></div>
          <noscript><p>JavaScript est nécessaire pour envoyer ce formulaire. / JavaScript is required to send this form.</p></noscript>
          <div class="flex items-center justify-between gap-4 pt-7">
            <p id="footer-form-status" role="status" aria-live="polite" class="hand text-xl hidden"></p>
            <button
              type="submit"
              class="ml-auto px-7 py-3.5 rounded-full font-display font-semibold text-sm bg-[var(--pen)] text-[var(--paper-raised)] hover:bg-[var(--pen-deep)] transition-colors disabled:opacity-50"
            >
              {t.sendButton} →
            </button>
          </div>
        </form>

      </div>
    </div>

  <!-- Barre basse -->
  <div class="border-t border-[var(--paper-edge)] px-6 md:px-12">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 py-6 text-xs text-ink-faint">
      <div class="flex items-center gap-2">
        © {new Date().getFullYear()} digitaldream.work · <a href="/rss.xml" class="underline decoration-dotted underline-offset-4 hover:text-[var(--pen)] transition-colors">rss</a>
      </div>
      <div class="flex items-center gap-2.5">
        <img src="/avatar-dd-96.webp" alt="" width="20" height="24" class="w-5 h-auto -rotate-3 block dark:hidden" />
        <img src="/avatar-dd-white.svg" alt="" width="20" height="24" class="w-5 h-auto -rotate-3 hidden dark:block" />
        <span class="hand text-lg text-ink-soft">{t.handWritten}</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
(() => {
  function initContact() {
    const form = document.querySelector('[data-contact-form]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const en = form.dataset.lang === 'en';
    const status = form.querySelector('[role="status"]');
    const button = form.querySelector('button[type="submit"]');
    const buttonText = button.textContent;
    let widget;
    let loading;
    let busy = false;
    const show = (text, ok = false) => {
      status.textContent = text;
      status.classList.remove('hidden', 'text-red-400', 'text-green-400');
      status.style.color = ok ? 'var(--ink)' : 'var(--pen)';
    };
    const loadChallenge = () => {
      if (loading) return loading;
      loading = (async () => {
        if (!form.dataset.sitekey) throw new Error('unconfigured');
        if (!window.turnstile) {
          if (!window.contactTurnstileLoading) {
            window.contactTurnstileLoading = new Promise((resolve, reject) => {
              const script = document.createElement('script');
              script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
              script.async = true;
              script.onload = resolve;
              script.onerror = () => { script.remove(); reject(new Error('load')); };
              document.head.appendChild(script);
            }).catch(error => { window.contactTurnstileLoading = null; throw error; });
          }
          await window.contactTurnstileLoading;
        }
        if (!form.isConnected) return;
        widget = window.turnstile.render(form.querySelector('[data-contact-challenge]'), {
          sitekey: form.dataset.sitekey, action: 'contact', theme: 'auto',
          language: en ? 'en' : 'fr', size: 'flexible',
        });
      })().catch(error => { loading = null; throw error; });
      return loading;
    };
    // Only load the anti-bot script when someone uses the form.
    form.addEventListener('focusin', () => { loadChallenge().catch(() => {}); });
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (busy) return;
      busy = true;
      button.disabled = true;
      button.textContent = en ? 'Sending…' : 'Envoi…';
      try {
        await loadChallenge();
        const token = window.turnstile.getResponse(widget);
        if (!token) {
          show(en ? 'Please complete the anti-spam verification.' : 'Merci de terminer la vérification antispam.');
          return;
        }
        const fields = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: fields.get('name'), email: fields.get('email'),
            message: fields.get('message'), website: fields.get('website'),
            botcheck: fields.has('botcheck'), token }),
          signal: AbortSignal.timeout(45000),
        });
        const result = await response.json();
        if (response.status === 429) {
          show(en ? 'Please wait a minute before trying again.' : 'Merci de patienter une minute avant de réessayer.');
        } else if (response.ok && result.ok) {
          form.reset();
          show(en ? 'Message sent, thank you!' : 'Message envoyé, merci !', true);
        } else { throw new Error('send'); }
      } catch {
        show(en ? 'The message could not be sent. Please try again.' : "Le message n’a pas pu être envoyé. Merci de réessayer.");
      } finally {
        if (widget !== undefined) window.turnstile?.reset(widget);
        busy = false;
        button.disabled = false;
        button.textContent = buttonText;
      }
    });
    document.addEventListener('astro:before-swap', () => {
      if (widget !== undefined) window.turnstile?.remove(widget);
    }, { once: true });
  }
  initContact();
  if (!window.contactInitRegistered) {
    document.addEventListener('astro:page-load', initContact);
    window.contactInitRegistered = true;
  }
})();
</script>
