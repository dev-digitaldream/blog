---
export interface Props {
  lang?: 'fr' | 'en';
}
const { lang: _lang } = Astro.props;
const currentLang = _lang || 'fr';

const translations = {
  fr: {
    hand: 'écris-moi',
    nameLabel: "Nom",
    emailLabel: "Email",
    messageLabel: "Message",
    sendButton: "Envoyer",
    copyright: "Tous droits réservés.",
    handWritten: "écrit à la main par DD",
  },
  en: {
    hand: 'write to me',
    nameLabel: "Name",
    emailLabel: "Email",
    messageLabel: "Message",
    sendButton: "Send",
    copyright: "All rights reserved.",
    handWritten: "handwritten by DD",
  },
};

const t = translations[currentLang];
---

<footer id="contact" class="bg-notebook text-ink border-t border-[var(--paper-edge)]">

  <!-- CTA + Formulaire -->
  <div class="px-6 md:px-12 py-20 md:py-28 max-w-6xl mx-auto">

      <!-- Label + grand titre -->
      <div class="mb-14 md:mb-20">
        <p class="hand text-2xl md:text-3xl text-pen rotate-[-1.5deg] mb-4">{t.hand}</p>
        <h2 class="font-display font-extrabold tracking-tight text-4xl md:text-6xl leading-[1.05] max-w-4xl text-ink">
          {currentLang === 'fr' ? (
            <>Une question, une idée,<br />ou juste <span class="u-hand">envie d'échanger&nbsp;?</span></>
          ) : (
            <>A question, an idea,<br />or just <span class="u-hand">want to chat</span>?</>
          )}
        </h2>
      </div>

      <!-- Grille contact -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">

        <!-- Colonne gauche : description -->
        <div class="md:col-span-4 space-y-8">
          <div>
            <p class="hand text-xl text-pen mb-2">01.</p>
            <p class="font-serif text-base leading-relaxed text-ink-soft max-w-sm">
              {currentLang === 'fr'
                ? "Pas de réseaux sociaux. Juste un formulaire direct. Je réponds à chaque message personnellement."
                : "No social media. Just a direct form. I respond to every message personally."}
            </p>
          </div>
          <div>
            <p class="hand text-xl text-pen mb-2">02.</p>
            <p class="font-serif text-sm leading-relaxed text-ink-faint max-w-sm">
              {currentLang === 'fr'
                ? "Pour parler d'un projet, signaler une erreur dans un article, proposer un produit à tester, ou juste discuter."
                : "To discuss a project, report an error in an article, propose a product for review, or just chat."}
            </p>
          </div>
        </div>

        <!-- Colonne droite : formulaire -->
        <form
          id="footer-contact-form"
          class="md:col-span-8 space-y-0 border-t border-[var(--paper-edge)]"
          onsubmit="handleFooterForm(event)"
        >
          <!-- Honeypot (invisible aux humains, visible aux bots) -->
          <input
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;opacity:0;pointer-events:none"
          />
          <!-- Champ piège secondaire -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;opacity:0;pointer-events:none"
          />
          <!-- Timestamp pour détecter soumission trop rapide (bots remplissent en <2s) -->
          <input type="hidden" name="form_loaded_at" id="form_loaded_at" />

          <div class="grid grid-cols-1 sm:grid-cols-2">
            <label class="group block py-5 border-b border-[var(--paper-edge)] sm:border-r">
              <span class="font-sans text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-faint block mb-2">{t.nameLabel}</span>
              <input
                type="text"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full bg-transparent border-0 p-0 font-serif text-lg md:text-xl text-ink placeholder-[var(--ink-faint)] focus:outline-none focus:ring-0"
              />
            </label>
            <label class="group block py-5 border-b border-[var(--paper-edge)] sm:pl-6">
              <span class="font-sans text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-faint block mb-2">{t.emailLabel}</span>
              <input
                type="email"
                name="email"
                required
                placeholder="hello@email.com"
                class="w-full bg-transparent border-0 p-0 font-serif text-lg md:text-xl text-ink placeholder-[var(--ink-faint)] focus:outline-none focus:ring-0"
              />
            </label>
          </div>
          <label class="group block py-5 border-b border-[var(--paper-edge)]">
            <span class="font-sans text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-faint block mb-2">{t.messageLabel}</span>
            <textarea
              name="message"
              required
              rows="4"
              placeholder={currentLang === 'fr' ? "Dites-moi tout..." : "Tell me everything..."}
              class="w-full bg-transparent border-0 p-0 font-serif text-lg md:text-xl text-ink placeholder-[var(--ink-faint)] focus:outline-none focus:ring-0 resize-none"
            ></textarea>
          </label>
          <div class="flex items-center justify-between gap-4 pt-7">
            <p id="footer-form-status" class="hand text-xl hidden"></p>
            <button
              type="submit"
              class="ml-auto px-7 py-3.5 rounded-full font-display font-semibold text-sm bg-[var(--pen)] text-[var(--paper-raised)] hover:bg-[var(--pen-deep)] transition-colors disabled:opacity-50"
            >
              {t.sendButton} →
            </button>
          </div>
        </form>

      </div>
    </div>

  <!-- Barre basse -->
  <div class="border-t border-[var(--paper-edge)] px-6 md:px-12">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 py-6 text-xs text-ink-faint">
      <div class="flex items-center gap-2">
        © {new Date().getFullYear()} digitaldream.work · <a href="/rss.xml" class="underline decoration-dotted underline-offset-4 hover:text-[var(--pen)] transition-colors">rss</a>
      </div>
      <div class="flex items-center gap-2.5">
        <img src="/avatar-dd-96.webp" alt="" width="20" height="24" class="w-5 h-auto -rotate-3 block dark:hidden" />
        <img src="/avatar-dd-white.svg" alt="" width="20" height="24" class="w-5 h-auto -rotate-3 hidden dark:block" />
        <span class="hand text-lg text-ink-soft">{t.handWritten}</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const translations = {
    fr: {
      successMessage: "Message envoyé, merci !",
      errorMessage: "Erreur lors de l'envoi. Réessayez.",
      sending: "Envoi…",
      tooFast: "Merci de prendre un instant pour rédiger votre message.",
      botDetected: "Une erreur est survenue.",
    },
    en: {
      successMessage: "Message sent, thank you!",
      errorMessage: "Error sending message. Please try again.",
      sending: "Sending…",
      tooFast: "Please take a moment to write your message.",
      botDetected: "An error occurred.",
    },
  };

  const currentLang = localStorage.getItem('lang') || 'fr';
  const t = translations[currentLang] || translations.fr;

  // Marque le moment où le formulaire est chargé (anti-spam timing)
  function stampLoadedAt() {
    const ts = document.getElementById('form_loaded_at');
    if (ts) ts.value = String(Date.now());
  }
  document.addEventListener('DOMContentLoaded', stampLoadedAt);
  // Re-stamp après navigation ClientRouter
  document.addEventListener('astro:page-load', stampLoadedAt);

  async function handleFooterForm(event) {
    event.preventDefault();
    const form = event.target;
    const status = document.getElementById('footer-form-status');
    const button = form.querySelector('button[type="submit"]');

    // === ANTI-SPAM ===
    // 1. Honeypot : si rempli, c'est un bot
    if (form.botcheck && form.botcheck.checked) {
      status.textContent = t.botDetected;
      status.classList.remove('hidden');
      return;
    }
    if (form.website && form.website.value !== '') {
      status.textContent = t.botDetected;
      status.classList.remove('hidden');
      return;
    }

    // 2. Délai minimum de 3 secondes (les bots soumettent instantanément)
    const loadedAt = parseInt(form.form_loaded_at?.value || '0', 10);
    const elapsed = Date.now() - loadedAt;
    if (loadedAt && elapsed < 3000) {
      status.textContent = t.tooFast;
      status.classList.remove('hidden');
      return;
    }

    // 3. Validation basique des champs
    if (!form.name.value.trim() || !form.email.value.trim() || !form.message.value.trim()) return;
    if (form.message.value.trim().length < 10) {
      status.textContent = currentLang === 'fr' ? 'Votre message est trop court.' : 'Your message is too short.';
      status.classList.remove('hidden');
      return;
    }

    button.disabled = true;
    button.textContent = t.sending;

    // === FORMBRICKS ===
    const FB_URL = 'https://formbricks.dev.digitaldream.work';
    const FB_ENV = 'cmk12myhj0009qz019fi6vmdm';
    const FB_SURVEY = 'cmk16vox50000kj0175n4djy7';

    try {
      const res = await fetch(`${FB_URL}/api/v1/client/${FB_ENV}/responses`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          surveyId: FB_SURVEY,
          finished: true,
          data: {
            name: form.name.value,
            email: form.email.value,
            message: form.message.value,
          },
          meta: {
            source: 'blog.digitaldream.work',
            url: window.location.href,
          },
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (res.ok && json?.data?.id) {
        status.textContent = t.successMessage;
        status.classList.remove('hidden', 'text-red-400');
        status.classList.add('text-green-400');
        form.reset();
        const ts = document.getElementById('form_loaded_at');
        if (ts) ts.value = String(Date.now());
      } else {
        console.error('[contact] Formbricks error:', res.status, json);
        throw new Error(json?.message || `HTTP ${res.status}`);
      }
    } catch (err) {
      console.error('[contact] Submit failed:', err);
      status.textContent = `${t.errorMessage} (${err?.message || 'network'})`;
      status.classList.remove('hidden', 'text-green-400');
      status.classList.add('text-red-400');
    } finally {
      button.disabled = false;
      button.textContent = currentLang === 'fr' ? 'Envoyer' : 'Send';
      status.classList.remove('hidden');
    }
  }
</script>
