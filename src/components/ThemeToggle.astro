---
const themes = ['light', 'dark', 'system'] as const;
type Theme = typeof themes[number];
---

<div class="theme-switcher" data-theme-toggle>
  <span class="theme-indicator" data-theme-indicator aria-hidden="true"></span>
  {themes.map((theme) => (
    <button
      type="button"
      data-theme-value={theme}
      aria-label={`Theme ${theme}`}
      aria-pressed="false"
      class="theme-btn group"
      onclick={`setTheme('${theme}')`}
    >
      {theme === 'light' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      )}
      {theme === 'dark' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      )}
      {theme === 'system' && (
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      )}
    </button>
  ))}
</div>

<style>
  .theme-switcher {
    --theme-step: 30px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border: 1px solid color-mix(in srgb, var(--ink-faint) 54%, transparent);
    border-radius: 999px;
  }

  .theme-indicator {
    position: absolute;
    inset-block: 2px;
    inset-inline-start: 2px;
    width: 28px;
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 3px 9px color-mix(in srgb, var(--shadow-ink) 18%, transparent);
    transform: translateX(calc(var(--theme-index, 0) * var(--theme-step)));
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-btn {
    position: relative;
    z-index: 1;
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 999px;
    color: var(--ink-soft);
    transition: color 180ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-btn:hover { color: var(--ink); }
  .theme-btn:active { transform: scale(0.88); }
  .theme-btn[aria-pressed='true'] { color: var(--paper-raised); }
  .theme-btn:focus-visible { outline: 2px solid var(--pen); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .theme-indicator { transition-duration: 80ms; }
    .theme-btn { transition-duration: 80ms; }
    .theme-btn:active { transform: none; }
  }
</style>

<script is:inline>
  let themeTransitionTimer;

  function applyTheme(theme, animate = false) {
    const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('theme-transitioning');
      clearTimeout(themeTransitionTimer);
      themeTransitionTimer = setTimeout(() => document.documentElement.classList.remove('theme-transitioning'), 300);
    }
    document.documentElement.classList.toggle('dark', isDark);
    const favicon = document.getElementById('favicon');
    if (favicon) favicon.href = isDark ? '/avatar-dd-white.svg' : '/favicon-light.svg';
    const themeIndex = ['light', 'dark', 'system'].indexOf(theme);
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
      toggle.style.setProperty('--theme-index', Math.max(themeIndex, 0));
    });
    document.querySelectorAll('[data-theme-value]').forEach((btn) => {
      const isActive = btn.getAttribute('data-theme-value') === theme;
      btn.setAttribute('aria-pressed', String(isActive));
    });
  }

  function setTheme(theme) {
    localStorage.setItem('theme', theme);
    applyTheme(theme, true);
  }

  // Initialize active state on load
  document.addEventListener('DOMContentLoaded', () => {
    applyTheme(localStorage.getItem('theme') || 'system');
  });

  // Listen for system theme changes
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if ((localStorage.getItem('theme') || 'system') === 'system') {
      applyTheme('system', true);
    }
  });
</script>
